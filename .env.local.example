# Supabase 설정
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 클라우드 TTS (음성 발음) - 서버 전용, 브라우저에 노출되지 않음
# OpenAI API 키: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Supabase service_role 키: 프로젝트 Settings > API > service_role
# 용도: TTS Storage 캐싱 (선택. 없으면 매번 OpenAI로 생성)
# 주의: 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 (클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 뜻 자동 채우기 모델 (선택). 비우면 gpt-5.4-mini. 모델이 단종되면 여기서 바꿈
# OPENAI_TEXT_MODEL=gpt-5.4-mini
